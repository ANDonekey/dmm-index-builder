# /etc/dmm-proxy.env —— 复制本文件后按实际修改，权限 chmod 600
# 改动后：systemctl restart dmm-proxy

# ── 必填 ──────────────────────────────────────────────
# 对外域名后缀（写进 nginx server_name 的那个主域）
HOST_SUFFIX=example.com

# ── 监听与白名单 ──────────────────────────────────────
LISTEN=127.0.0.1:8080
ALLOWED_CDN=cc3001,pv3001
UPSTREAM_SUFFIX=.dmm.co.jp
UPSTREAM_SCHEME=https
# 路径白名单，逗号分隔。两个都要：
#   /litevideo/freepv/ 老体系（<a>/<ab>/<stem>/<stem>_<q>_<v>.mp4）
#   /pv/              新体系（<62位随机token>/<file>.mp4），约 9 万条
# 只对其中一个放行，另一体系的预览会全部 403。
PATH_PREFIXES=/litevideo/freepv/,/pv/
# PATH_PREFIX= 是旧的单值写法，仍兼容（PATH_PREFIXES 为空时才生效）

# ── 上游代理（sing-box 本地 socks 入站，dmm.co.jp 已分流到 jp-group） ──
UPSTREAM_PROXY=socks5://127.0.0.1:1080

# ── 出站头 ────────────────────────────────────────────
UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
REFERER=https://www.dmm.co.jp/
ORIGIN=https://www.dmm.co.jp
ACCEPT_LANGUAGE=ja-JP,ja;q=0.9,en;q=0.8

# ── 磁盘缓存 ──────────────────────────────────────────
CACHE_DIR=/var/cache/dmmpv
CACHE_MAX_BYTES=6442450944          # 6 GB
CACHE_MIN_FREE_BYTES=2147483648     # 分区剩余 < 2GB 就不再落盘
CACHE_MAX_DOWNLOADS=2               # 并发回源数
MIN_BODY_BYTES=1024                 # 小于此值视为“假 200”，不落盘

# 只缓存这些档位（留空 = 全缓存）。取消注释可显著降低磁盘占用：
# CACHE_QUALITY_ALLOW=sm,dm,dmb

# ── 流量限制（防节点流量超支）────────────────────────
# 配额单位一律是「计费后」的字节 = 真实字节 × QUOTA_BILLING_FACTOR，
# 这样和服务商后台看到的扣量一致。想按真实字节计量就把系数设成 1。
QUOTA_BILLING_FACTOR=0.1        # 0.1 倍节点：下 41MB 只扣 4.1MB 额度
QUOTA_DAILY_BYTES=2147483648    # 每日回源上限 2GB（计费口径）≈ 500 部 41MB 新片
QUOTA_MONTHLY_BYTES=32212254720 # 每月上限 30GB（计费口径）
QUOTA_MAX_PER_REQUEST=67108864  # 单次回源真实字节硬上限 64MB，防异常大文件
QUOTA_EXCEEDED_CODE=429         # 超限时的状态码（可改 503）
RATE_LIMIT_PER_MIN=60           # 每分钟回源次数上限，防刷不同 URL

# ── 其它 ──────────────────────────────────────────────
# 超限时：已缓存的内容照常能看，只有新片回源会失败（429 + no-store）。
CACHE_CONTROL=public, max-age=31536000, s-maxage=31536000, immutable
UPSTREAM_TIMEOUT=10m                # 单文件回源总超时（含下完整个文件）
FLIGHT_WAIT=3m                      # follower 等待 leader 的最长时间
