LISTEN=127.0.0.1:8091
UPSTREAM=https://media.javtrailers.com
TLS_PROFILE=chrome120

# ── 链接签名 ──────────────────────────────────────────────────
# ⚠️ systemd 的 EnvironmentFile 不解析行尾注释，说明只能单独占行。
#
# DMM_SIGN_SECRET：必须与 dmm-query / dmm-proxy 配**同一个值**。
#   留空 = 不校验（灰度/回滚用）。
DMM_SIGN_SECRET=

# 1 = 验签失败直接 403；0 = 只记日志放行（先观察一天，确认没有误杀再改 1）。
DMM_SIGN_ENFORCE=1
