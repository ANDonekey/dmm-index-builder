LISTEN=127.0.0.1:8091
UPSTREAM=https://media.javtrailers.com
TLS_PROFILE=chrome120

# ── 链接签名 ──────────────────────────────────────────────────
# ⚠️ systemd 的 EnvironmentFile 不解析行尾注释，说明只能单独占行。
#
# DMM_SIGN_SECRET：**当前生产留空（关闭）**。签名会让 URL 每天变一次，
#   把 CF 缓存打碎，而 CF 对 /mirror/ 的规则忽略 query，缓存命中不看签名。
#   现在只保留查询准入。要启用见 docs/dmm-preview-auth.md。
DMM_SIGN_SECRET=

# 1 = 验签失败直接 403；0 = 只记日志放行。只在 secret 非空时有意义。
DMM_SIGN_ENFORCE=1
