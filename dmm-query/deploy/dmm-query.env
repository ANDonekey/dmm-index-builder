LISTEN=127.0.0.1:8090
DB_PATH=/var/lib/dmmpv/dmm-index.db
PUBLIC_HOST=cc3001.fastcdn.dpdns.org
PROXY_HOST=fastcdn.dpdns.org
CACHE_KIB=16384

# ── 准入与签名 ────────────────────────────────────────────────
# ⚠️ 这个文件是 systemd 的 EnvironmentFile：**不能写行尾注释**，
#    否则整串（含 # 和后面的字）都会被当成值。说明只能单独占行。
#
# DMM_QUERY_KEY：查询准入。前端不直连本服务，而是经本站 Pages Functions 代查，
#   密钥只在服务端。留空 = 不校验（灰度/回滚用）。
#   生成：openssl rand -hex 32
DMM_QUERY_KEY=

# DMM_SIGN_SECRET：预览链接签名密钥。**当前生产留空（关闭）**。
#   原因：签名会让 URL 每天变一次，把 CF 边缘缓存打碎；而 CF 的 /mirror/
#   缓存规则本身忽略 query，缓存命中根本不看签名 —— 防护收益几乎为零。
#   现在只保留查询准入（DMM_QUERY_KEY）。要重新启用见 docs/dmm-preview-auth.md。
#   启用时三个服务（query/proxy/mirror）必须配同一个值。
#   生成：openssl rand -hex 32
DMM_SIGN_SECRET=

# 签名有效期（天，按 UTC 天对齐）。7 = 实际可用 7~8 天，URL 每天换一次。
# 只在 DMM_SIGN_SECRET 非空时有意义。
DMM_SIGN_TTL_DAYS=7

# ── 库未命中时的实时回退 ──────────────────────────────────────
# 主索引库来自 r18.dev 的每周 dump，新片/冷门片查不到。开着它就会去查 DMM
# 拿 cid，结果落下面这个独立库**永久复用**（只存 cid，地址现算）。
# 0 = 关闭（查不到就是 404）。
FALLBACK_ENABLED=1

# 独立可写库。主索引库是只读且每周整库替换的，绝不能往里写；
# 单元里 /var/lib/dmmpv 整条是 ReadOnlyPaths，所以另开 StateDirectory。
FALLBACK_DB=/var/lib/dmmpv-fallback/dmm-fallback.db

# ── 主路：DMM affiliate API（推荐）─────────────────────────────
# 官方接口 api.dmm.com/affiliate/v3/ItemList，纯 JSON、直连约 0.6s、
# **不挑出口**（不需要日本 IP，只有 www.dmm.co.jp 才有地域限制）。
# 两个都填了才启用；任一为空就退回下面的搜索页兜底。
# 值在 DMM affiliate 后台（https://affiliate.dmm.com/）的「API」页。
# ⚠️ 限流是 api_id 级的、跨 IP 全局生效（并发打高会整批 400 好几分钟），
#    所以回退是串行 + 同番号合并的，别在这上面加并发。
DMM_API_ID=
DMM_AFFILIATE_ID=

# ── 兜底：DMM 搜索页（仅当上面没配、或 API 硬失败时用）─────────
# 搜索页对非日本 IP 直接拒绝，必须走 sing-box 的 socks 入站。
FALLBACK_PROXY=socks5://127.0.0.1:1080

# 单次回源超时 / 搜索页两次回源之间的最小间隔（防把搜索页打爆）。
FALLBACK_TIMEOUT=12s
FALLBACK_MIN_INTERVAL=1s

# 负结果（确认查不到）的保质期，单位天。正结果永不过期。
# 不能太大：否则今天没上架的片，以后一直被判「没有」。
FALLBACK_MISS_TTL_DAYS=3
